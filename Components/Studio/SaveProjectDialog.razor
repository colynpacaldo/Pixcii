@using System.ComponentModel.DataAnnotations

<MudDialog>
    <TitleContent>
        <div class="text-sm font-semibold text-[#eae6df]">Save project</div>
    </TitleContent>

    <DialogContent>
        <div class="flex flex-col gap-4 pt-1">
            <MudTextField T="string"
                          @bind-Value="_title"
                          Label="Title"
                          Variant="Variant.Outlined"
                          Required="true"
                          MaxLength="120"
                          Immediate="true"
                          Placeholder="Untitled sprite" />

            <MudTextField T="string"
                          @bind-Value="_authorName"
                          Label="Author"
                          Variant="Variant.Outlined"
                          Required="true"
                          MaxLength="80"
                          Immediate="true"
                          Placeholder="Your name" />

            <div class="rounded-[3px] border border-[#2e2e2e] bg-[#222222] p-3">
                <MudSwitch T="bool"
                           @bind-Value="_isPublic"
                           Color="Color.Primary"
                           Label="Publish to Gallery" />
                <div class="mt-1 text-xs text-[#96928b]">
                    When enabled, anyone can view, react to, and remix this project in the Gallery.
                </div>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Save"
                   Disabled="@(string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_authorName))"
                   OnClick="Submit">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record SaveProjectResult(string Title, string AuthorName, bool IsPublic);

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string InitialTitle { get; set; } = "Untitled Sprite";
    [Parameter] public string InitialAuthorName { get; set; } = "Classmate";
    [Parameter] public bool InitialIsPublic { get; set; } = true;

    private string _title = string.Empty;
    private string _authorName = string.Empty;
    private bool _isPublic = true;

    protected override void OnInitialized()
    {
        _title = InitialTitle;
        _authorName = InitialAuthorName;
        _isPublic = InitialIsPublic;
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(new SaveProjectResult(
            _title.Trim(),
            _authorName.Trim(),
            _isPublic)));
    }

    private void Cancel() => MudDialog.Cancel();
}
