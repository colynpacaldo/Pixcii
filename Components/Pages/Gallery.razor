@page "/gallery"
@using System.Diagnostics
@using System.Globalization
@implements IDisposable
@inject ProjectService ProjectService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Pixcii — Gallery</PageTitle>

<div class="flex h-full w-full min-w-0 flex-col overflow-hidden bg-[#141414]">
    @* ===================================================================== *@
    @* GALLERY HEADER                                                        *@
    @* ===================================================================== *@
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[#2e2e2e] bg-[#1b1b1b] px-6 py-4">
        <div class="min-w-0">
            <h1 class="m-0 text-sm font-semibold text-[#eae6df]">Gallery</h1>
            <p class="mt-0.5 text-xs text-[#96928b]">
                Browse animations from the class, react, or open a copy in the Studio.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <div class="w-44">
                <MudTextField T="string"
                              @bind-Value="_remixAuthorName"
                              Label="Your name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="Classmate" />
            </div>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       OnClick="LoadGalleryAsync">
                Refresh
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Brush"
                       Href="/studio">
                Open Studio
            </MudButton>
        </div>
    </div>

    @* Filter Chips *@
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#2e2e2e] bg-[#1b1b1b] px-6 py-2">
        <MudChipSet T="string"
                    SelectedValue="_selectedFilter"
                    SelectedValueChanged="OnFilterChanged"
                    SelectionMode="SelectionMode.SingleSelection"
                    CheckMark="true">
            <MudChip Value="@("All")"
                     Text="All"
                     Color="@(_selectedFilter == "All" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedFilter == "All" ? Variant.Filled : Variant.Outlined)" />
            <MudChip Value="@("Ascii")"
                     Text="ASCII"
                     Color="@(_selectedFilter == "Ascii" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedFilter == "Ascii" ? Variant.Filled : Variant.Outlined)" />
            <MudChip Value="@("PixelArt")"
                     Text="Pixel art"
                     Color="@(_selectedFilter == "PixelArt" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedFilter == "PixelArt" ? Variant.Filled : Variant.Outlined)" />
            <MudChip Value="@("Popular")"
                     Text="Most popular"
                     Color="@(_selectedFilter == "Popular" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedFilter == "Popular" ? Variant.Filled : Variant.Outlined)" />
        </MudChipSet>

        <span class="font-mono text-[11px] text-[#96928b]">
            @_projects.Count @(_projects.Count == 1 ? "project" : "projects")
        </span>
    </div>

    @* ===================================================================== *@
    @* RESPONSIVE CARD GRID                                                  *@
    @* ===================================================================== *@
    <div class="pixcii-workspace min-w-0 flex-1 overflow-x-hidden overflow-y-auto p-6">
        @if (_isLoading)
        {
            <div class="flex h-64 items-center justify-center">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
            </div>
        }
        else if (_projects.Count == 0)
        {
            <div class="mx-auto mt-12 flex max-w-md flex-col items-center gap-3 rounded-[3px] border border-[#2e2e2e] bg-[#1b1b1b] p-6 text-center">
                <div class="text-sm font-semibold text-[#eae6df]">No public projects yet</div>
                <p class="text-xs text-[#96928b]">
                    Save an animation in the Studio and turn on Publish to Gallery to show it here.
                </p>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/studio">
                    Open Studio
                </MudButton>
            </div>
        }
        else
        {
            <div class="grid w-full min-w-0 grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var project in _projects)
                {
                    var orderedFrames = GetOrderedFrames(project);
                    var activeFrame = orderedFrames.Count > 0
                        ? orderedFrames[GetCurrentFrameIndex(project, orderedFrames.Count)]
                        : null;

                    <MudCard @key="project.Id"
                             Elevation="0"
                             Class="flex min-w-0 flex-col overflow-hidden rounded-[3px] border border-[#2e2e2e] bg-[#1b1b1b]">

                        @* Uniform 4:3 Preview Well (12px padding) *@
                        <div class="pixcii-checkerboard relative flex aspect-[4/3] w-full min-w-0 items-center justify-center overflow-hidden border-b border-[#2e2e2e] p-3">
                            @if (activeFrame is not null && project.Mode == ProjectMode.PixelArt && !string.IsNullOrEmpty(activeFrame.PixelDataBase64))
                            {
                                <img src="@($"data:image/png;base64,{activeFrame.PixelDataBase64}")"
                                     alt="@project.Title"
                                     class="pixelated max-h-full max-w-full object-contain"
                                     style="image-rendering: pixelated;" />
                            }
                            else if (activeFrame is not null && project.Mode == ProjectMode.Ascii && GetCachedAsciiPreview(activeFrame) is { } ascii)
                            {
                                var scale = GetAsciiPreviewScale(ascii.Columns, ascii.Rows);
                                <div class="flex h-full w-full items-center justify-center overflow-hidden rounded-[2px] border border-[#2e2e2e] bg-[#141414]">
                                    <pre class="m-0 font-mono leading-[1.1] whitespace-pre select-none"
                                         style="@($"font-size: 10px; transform: scale({scale.ToString("0.###", CultureInfo.InvariantCulture)}); transform-origin: center center;")">@((MarkupString)ascii.ColoredHtml)</pre>
                                </div>
                            }
                            else
                            {
                                <div class="flex h-full w-full items-center justify-center overflow-hidden rounded-[2px] border border-[#2e2e2e] bg-[#141414] p-3">
                                    <pre class="m-0 text-center font-mono text-[11px] leading-tight text-[#96928b] whitespace-pre select-none">@BuildFallbackAsciiBanner(project)</pre>
                                </div>
                            }
                        </div>

                        @* Card Body (12px padding) *@
                        <div class="flex flex-1 flex-col justify-between gap-3 p-3">
                            <div class="min-w-0">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="truncate text-sm font-medium text-[#eae6df]" title="@project.Title">
                                        @project.Title
                                    </div>
                                    <span class="shrink-0 rounded-[2px] border border-[#3d3d3d] bg-[#222222] px-1.5 py-0.5 text-[11px] text-[#96928b]">
                                        @(project.Mode == ProjectMode.Ascii ? "ASCII" : "Pixel")
                                    </span>
                                </div>

                                <div class="mt-1 flex items-center justify-between gap-2 text-xs text-[#96928b]">
                                    <span class="truncate">@project.AuthorName@(project.RemixedFromId.HasValue ? " · Remix" : "")</span>
                                    <span class="shrink-0 font-mono text-[11px]">@orderedFrames.Count f · @project.Fps FPS</span>
                                </div>
                            </div>

                            <div class="flex flex-col gap-2">
                                @* Quiet Reaction Row (MudBlazor SVG icons + mono count; neutral until clicked) *@
                                <div class="flex items-center gap-1.5">
                                    @foreach (var reaction in _reactionButtons)
                                    {
                                        var count = GetReactionCount(project.Id, reaction.Key);
                                        var clicked = _clickedReactions.Contains((project.Id, reaction.Key));
                                        <button type="button"
                                                title="@reaction.Label"
                                                @onclick="() => ReactAsync(project.Id, reaction.Key)"
                                                class="@(clicked ? "border-[#e5a030]/70 text-[#e5a030]" : "border-[#2e2e2e] text-[#96928b] hover:border-[#3d3d3d] hover:text-[#eae6df]") px-btn flex flex-1 items-center justify-center gap-1.5 border bg-[#222222] px-2 cursor-pointer">
                                            <MudIcon Icon="@reaction.Icon" Size="Size.Small" />
                                            <span class="font-mono text-[11px]">@count</span>
                                        </button>
                                    }
                                </div>

                                @* Full-Width Secondary Remix Button (turns accent on hover) *@
                                <button type="button"
                                        disabled="@(_forkingProjectId == project.Id)"
                                        @onclick="() => RemixInStudioAsync(project.Id)"
                                        class="px-btn flex w-full items-center justify-center gap-1.5 border border-[#3d3d3d] bg-[#222222] px-3 text-xs font-medium text-[#eae6df] hover:border-[#e5a030] hover:bg-[#e5a030] hover:text-[#14110b] cursor-pointer">
                                    <MudIcon Icon="@Icons.Material.Outlined.ForkRight" Size="Size.Small" />
                                    <span>@(_forkingProjectId == project.Id ? "Opening..." : "Remix")</span>
                                </button>
                            </div>
                        </div>
                    </MudCard>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly (string Key, string Label, string Icon)[] _reactionButtons =
    [
        ("Fire", "Fire", Icons.Material.Outlined.LocalFireDepartment),
        ("Art", "Craft", Icons.Material.Outlined.Palette),
        ("Funny", "Fun", Icons.Material.Outlined.SentimentSatisfiedAlt)
    ];

    private IReadOnlyList<StudioProject> _projects = [];
    private Dictionary<Guid, List<ArtFrame>> _orderedFramesByProject = [];
    private Dictionary<Guid, int> _lastFrameIndices = [];
    private Dictionary<Guid, Dictionary<string, int>> _reactionCounts = [];
    private readonly HashSet<(Guid ProjectId, string ReactionType)> _clickedReactions = [];
    private readonly Dictionary<Guid, AsciiResult?> _asciiPreviewCache = [];

    private string _selectedFilter = "All";
    private string _remixAuthorName = "Classmate";
    private bool _isLoading = true;
    private Guid? _forkingProjectId;

    private readonly Stopwatch _clock = Stopwatch.StartNew();
    private CancellationTokenSource? _previewLoopCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadGalleryAsync();
        StartPreviewLoop();
    }

    private async Task OnFilterChanged(string? filter)
    {
        _selectedFilter = string.IsNullOrWhiteSpace(filter) ? "All" : filter;
        await LoadGalleryAsync();
    }

    private async Task LoadGalleryAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            ProjectMode? modeFilter = _selectedFilter switch
            {
                "Ascii" => ProjectMode.Ascii,
                "PixelArt" => ProjectMode.PixelArt,
                _ => null
            };
            var mostPopular = _selectedFilter == "Popular";

            _projects = await ProjectService.GetPublicGalleryAsync(
                page: 1,
                pageSize: 48,
                mode: modeFilter,
                mostPopular: mostPopular);

            _asciiPreviewCache.Clear();
            _orderedFramesByProject = _projects.ToDictionary(
                p => p.Id,
                p => p.ArtFrames.OrderBy(f => f.OrderIndex).ToList());
            _lastFrameIndices = _projects.ToDictionary(p => p.Id, _ => 0);

            _reactionCounts = _projects.ToDictionary(
                p => p.Id,
                p => p.Reactions
                    .GroupBy(r => r.ReactionType)
                    .ToDictionary(g => g.Key, g => g.Count()));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load gallery: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private List<ArtFrame> GetOrderedFrames(StudioProject project) =>
        _orderedFramesByProject.TryGetValue(project.Id, out var list) ? list : [];

    private int GetCurrentFrameIndex(StudioProject project, int frameCount)
    {
        if (frameCount <= 1)
        {
            return 0;
        }

        var frameDurationMs = Math.Max(40.0, 1000.0 / Math.Clamp(project.Fps, 1, 24));
        return (int)(_clock.ElapsedMilliseconds / frameDurationMs) % frameCount;
    }

    private int GetReactionCount(Guid projectId, string reactionType)
    {
        if (_reactionCounts.TryGetValue(projectId, out var counts) &&
            counts.TryGetValue(reactionType, out var count))
        {
            return count;
        }
        return 0;
    }

    private async Task ReactAsync(Guid projectId, string reactionType)
    {
        try
        {
            var updated = await ProjectService.AddReactionAsync(projectId, reactionType);
            _reactionCounts[projectId] = updated;
            _clickedReactions.Add((projectId, reactionType));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Reaction failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemixInStudioAsync(Guid projectId)
    {
        _forkingProjectId = projectId;
        StateHasChanged();

        try
        {
            var author = string.IsNullOrWhiteSpace(_remixAuthorName) ? "Classmate" : _remixAuthorName.Trim();
            var forked = await ProjectService.ForkProjectAsync(projectId, author);
            Navigation.NavigateTo($"/studio/{forked.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to remix project: {ex.Message}", Severity.Error);
            _forkingProjectId = null;
        }
    }

    private AsciiResult? GetCachedAsciiPreview(ArtFrame frame)
    {
        if (_asciiPreviewCache.TryGetValue(frame.Id, out var cached))
        {
            return cached;
        }

        var parsed = FrameSerialization.DeserializeAscii(
            frame.AsciiContent,
            MediaConversionService.BuildAsciiTextAndHtml);
        _asciiPreviewCache[frame.Id] = parsed;
        return parsed;
    }

    private static double GetAsciiPreviewScale(int columns, int rows)
    {
        var naturalWidth = Math.Max(1, columns) * 6.0;
        var naturalHeight = Math.Max(1, rows) * 11.0;
        return Math.Clamp(Math.Min(230.0 / naturalWidth, 160.0 / naturalHeight), 0.12, 1.15);
    }

    private static string BuildFallbackAsciiBanner(StudioProject project)
    {
        var label = project.Title.Length > 18 ? project.Title[..18] : project.Title;
        var border = new string('-', Math.Max(12, label.Length + 4));
        return $"+{border}+\n|  {label}  |\n|  {project.Width}x{project.Height} {project.Mode}  |\n+{border}+";
    }

    private void StartPreviewLoop()
    {
        _previewLoopCts?.Cancel();
        _previewLoopCts?.Dispose();
        _previewLoopCts = new CancellationTokenSource();
        _ = RunPreviewLoopAsync(_previewLoopCts.Token);
    }

    private async Task RunPreviewLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(40));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                var changed = false;
                foreach (var project in _projects)
                {
                    var count = GetOrderedFrames(project).Count;
                    if (count <= 1) continue;

                    var nextIdx = GetCurrentFrameIndex(project, count);
                    if (!_lastFrameIndices.TryGetValue(project.Id, out var prevIdx) || prevIdx != nextIdx)
                    {
                        _lastFrameIndices[project.Id] = nextIdx;
                        changed = true;
                    }
                }

                if (changed)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _previewLoopCts?.Cancel();
        _previewLoopCts?.Dispose();
    }
}
