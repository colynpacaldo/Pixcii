@page "/"
@inject StudioStateService StudioState

<PageTitle>Pixcii — ASCII &amp; Pixel Art Animation Studio</PageTitle>

<div class="flex flex-col items-center gap-4">
    <div class="flex items-center justify-between w-full px-1 font-mono text-xs text-slate-400">
        <span>FRAME 01 / 01</span>
        <span class="text-cyan-400">@StudioState.Metadata.Mode.ToString().ToUpperInvariant() STAGE</span>
    </div>

    @* Centered Artboard Frame *@
    <div class="pixcii-checkerboard relative flex h-[420px] w-[420px] items-center justify-center rounded-lg border border-[#2a3145] shadow-[0_0_50px_rgba(0,0,0,0.65)]">
        @if (StudioState.ShowGrid)
        {
            <div class="pointer-events-none absolute inset-0 opacity-20"
                 style="background-image: linear-gradient(to right, #94a3b8 1px, transparent 1px), linear-gradient(to bottom, #94a3b8 1px, transparent 1px); background-size: 26.25px 26.25px;">
            </div>
        }

        <div class="relative z-10 flex flex-col items-center gap-2 rounded-md border border-[#232838] bg-[#0e1118]/90 px-5 py-4 text-center backdrop-blur-sm">
            <span class="font-mono text-xs font-semibold tracking-widest text-cyan-300">
                CANVAS WORKSPACE READY
            </span>
            <p class="max-w-[260px] text-xs text-slate-400">
                Active tool: <span class="font-mono text-slate-200">@StudioState.ActiveTool</span>
                &middot; Glyph <span class="font-mono text-amber-300">'@StudioState.ActiveAsciiGlyph'</span>
            </p>
        </div>
    </div>
</div>
