@page "/"
@page "/studio"
@page "/studio/{ProjectId:guid}"
@implements IDisposable
@inject MediaConversionService ConversionService
@inject AnimationFxService FxService
@inject ProjectService ProjectService
@inject StudioStateService StudioState
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Pixcii — Studio</PageTitle>

<div class="flex h-full w-full min-w-0 flex-col overflow-hidden lg:flex-row">
    @* ===================================================================== *@
    @* 1. LEFT INSPECTOR PANEL (16px padding, 20px group gaps)               *@
    @* ===================================================================== *@
    <MudPaper Elevation="0"
              Square="true"
              Class="w-full shrink-0 overflow-y-auto border-b border-[#2e2e2e] bg-[#1b1b1b] lg:h-full lg:w-[320px] lg:border-r lg:border-b-0">
        <div class="flex flex-col gap-5 p-4">

            @* Group 1: Mode & Presets directly underneath *@
            <div class="flex flex-col gap-3">
                <div class="text-sm font-semibold text-[#eae6df]">Mode</div>

                <MudToggleGroup T="ProjectMode"
                                Value="_mode"
                                ValueChanged="OnModeChanged"
                                Color="Color.Primary"
                                CheckMark="false"
                                FixedContent="true"
                                Outlined="true"
                                SelectionMode="SelectionMode.SingleSelection"
                                Class="w-full">
                    <MudToggleItem Value="ProjectMode.Ascii" Text="ASCII" />
                    <MudToggleItem Value="ProjectMode.PixelArt" Text="Pixel art" />
                </MudToggleGroup>

                @if (_mode == ProjectMode.Ascii)
                {
                    <div class="flex flex-col gap-3 pt-1">
                        <MudSelect T="string"
                                   Label="Character ramp"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Value="_rampPreset"
                                   ValueChanged="OnRampPresetChanged">
                            <MudSelectItem Value="@("Standard")">Standard (@@%#*+=-:. )</MudSelectItem>
                            <MudSelectItem Value="@("Dense")">Dense (70-char)</MudSelectItem>
                            <MudSelectItem Value="@("Blocks")">Blocks (&#9608;&#9619;&#9618;&#9617; )</MudSelectItem>
                            <MudSelectItem Value="@("Minimal")">Minimal (#+-. )</MudSelectItem>
                            <MudSelectItem Value="@("Custom")">Custom ramp</MudSelectItem>
                        </MudSelect>

                        @if (_rampPreset == "Custom")
                        {
                            <MudTextField T="string"
                                          Label="Custom characters"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Value="_customRamp"
                                          ValueChanged="OnCustomRampChanged"
                                          HelperText="Darkest/dense on left to space on right" />
                        }

                        <MudSelect T="AsciiColorMode"
                                   Label="Color output"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Value="_asciiColorMode"
                                   ValueChanged="OnAsciiColorModeChanged">
                            <MudSelectItem Value="AsciiColorMode.FullColorHtml">Full color</MudSelectItem>
                            <MudSelectItem Value="AsciiColorMode.MatrixGreen">Phosphor green</MudSelectItem>
                            <MudSelectItem Value="AsciiColorMode.Monochrome">Monochrome</MudSelectItem>
                        </MudSelect>
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-3 pt-1">
                        <MudSelect T="Guid"
                                   Label="Palette"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Value="_selectedPaletteId"
                                   ValueChanged="OnPaletteChanged">
                            @foreach (var palette in _palettes)
                            {
                                <MudSelectItem Value="@palette.Id">@palette.Name</MudSelectItem>
                            }
                        </MudSelect>

                        @if (ActivePaletteColors.Length > 0)
                        {
                            <div class="flex flex-wrap gap-1.5 rounded-[3px] border border-[#2e2e2e] bg-[#222222] p-2">
                                @foreach (var hex in ActivePaletteColors)
                                {
                                    var isPaintActive = string.Equals(_paintHexColor, hex, StringComparison.OrdinalIgnoreCase) && !_paintEraser;
                                    <button type="button"
                                            title="@($"Select {hex}")"
                                            @onclick="() => SelectPaintColor(hex)"
                                            class="@(isPaintActive ? "border-[#e5a030] ring-1 ring-[#e5a030]" : "border-[#3d3d3d] hover:border-[#6a6760]") px-control h-5 w-5 rounded-[2px] border transition-colors duration-150 cursor-pointer"
                                            style="@($"background-color: {hex};")">
                                    </button>
                                }
                            </div>
                        }

                        <MudSwitch T="bool"
                                   Value="_applyDithering"
                                   ValueChanged="OnDitheringChanged"
                                   Color="Color.Primary"
                                   Label="Floyd-Steinberg dithering"
                                   Size="Size.Small" />
                    </div>
                }
            </div>

            <hr class="m-0 border-0 border-t border-[#2e2e2e]" />

            @* Group 2: Image Upload *@
            <div class="flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-[#eae6df]">Image</span>
                    <span class="font-mono text-[11px] text-[#96928b]">Max 5 MB</span>
                </div>

                <MudFileUpload T="IBrowserFile"
                               Accept=".png,.jpg,.jpeg,.webp"
                               MaximumFileCount="1"
                               FilesChanged="OnFileUploadedAsync">
                    <CustomContent Context="fileUpload">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Outlined.UploadFile"
                                   OnClick="@fileUpload.OpenFilePickerAsync">
                            Upload PNG / JPG / WebP
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>

                <div class="flex items-center justify-between gap-2">
                    <span class="truncate text-xs text-[#96928b]" title="@_sourceFileName">
                        @_sourceFileName
                    </span>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Size="Size.Small"
                               OnClick="LoadSampleImageAsync">
                        Load sample
                    </MudButton>
                </div>
            </div>

            <hr class="m-0 border-0 border-t border-[#2e2e2e]" />

            @* Group 3: Settings *@
            <div class="flex flex-col gap-3">
                <div class="text-sm font-semibold text-[#eae6df]">Settings</div>

                @if (_mode == ProjectMode.Ascii)
                {
                    <div>
                        <div class="flex justify-between text-xs text-[#eae6df]">
                            <span>Columns</span>
                            <span class="font-mono text-[11px] text-[#96928b]">@_asciiWidth</span>
                        </div>
                        <MudSlider T="int"
                                   Value="_asciiWidth"
                                   ValueChanged="OnAsciiWidthChanged"
                                   Min="16"
                                   Max="160"
                                   Step="4"
                                   Color="Color.Primary" />
                    </div>
                }
                else
                {
                    <div>
                        <div class="flex justify-between text-xs text-[#eae6df]">
                            <span>Grid size</span>
                            <span class="font-mono text-[11px] text-[#96928b]">@_pixelGridSize&times;@_pixelGridSize</span>
                        </div>
                        <MudSlider T="int"
                                   Value="_pixelGridSize"
                                   ValueChanged="OnPixelGridSizeChanged"
                                   Min="8"
                                   Max="128"
                                   Step="4"
                                   Color="Color.Primary" />
                    </div>
                }

                <div>
                    <div class="flex justify-between text-xs text-[#eae6df]">
                        <span>Brightness</span>
                        <span class="font-mono text-[11px] text-[#96928b]">@_brightness.ToString("0.00")</span>
                    </div>
                    <MudSlider T="float"
                               Value="_brightness"
                               ValueChanged="OnBrightnessChanged"
                               Min="0.30f"
                               Max="2.00f"
                               Step="0.05f"
                               Color="Color.Primary" />
                </div>

                <div>
                    <div class="flex justify-between text-xs text-[#eae6df]">
                        <span>Contrast</span>
                        <span class="font-mono text-[11px] text-[#96928b]">@_contrast.ToString("0.00")</span>
                    </div>
                    <MudSlider T="float"
                               Value="_contrast"
                               ValueChanged="OnContrastChanged"
                               Min="0.30f"
                               Max="2.00f"
                               Step="0.05f"
                               Color="Color.Primary" />
                </div>

                <MudSwitch T="bool"
                           Value="_invertBrightness"
                           ValueChanged="OnInvertChanged"
                           Color="Color.Primary"
                           Label="Invert brightness"
                           Size="Size.Small" />
            </div>
        </div>
    </MudPaper>

    @* ===================================================================== *@
    @* 2. CENTER CANVAS STAGE                                                *@
    @* ===================================================================== *@
    <div class="flex min-w-0 flex-1 flex-col overflow-hidden bg-[#141414]">
        @* Stage Toolbar (32px consistent controls) *@
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#2e2e2e] bg-[#1b1b1b] px-4 py-2">
            <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-[#eae6df]">
                    @(_mode == ProjectMode.Ascii ? "ASCII" : "Pixel art")
                </span>

                @if (_mode == ProjectMode.Ascii && _asciiResult is not null)
                {
                    <span class="rounded-[3px] border border-[#2e2e2e] bg-[#222222] px-2 py-1 font-mono text-[11px] text-[#96928b]">
                        @_asciiResult.Columns&times;@_asciiResult.Rows chars
                    </span>
                }
                else if (_mode == ProjectMode.PixelArt && _pixelResult is not null)
                {
                    <span class="rounded-[3px] border border-[#2e2e2e] bg-[#222222] px-2 py-1 font-mono text-[11px] text-[#96928b]">
                        @_pixelResult.Width&times;@_pixelResult.Height px
                    </span>
                }

                @if (_isConverting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                }
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <MudSwitch T="bool"
                           @bind-Value="_quickPaintEnabled"
                           Color="Color.Primary"
                           Label="Quick paint"
                           Size="Size.Small" />

                @if (_mode == ProjectMode.Ascii)
                {
                    <div class="flex h-8 items-center gap-1 rounded-[3px] border border-[#3d3d3d] bg-[#222222] px-2 text-xs">
                        <span class="text-[#96928b]">Font</span>
                        <button type="button" @onclick="() => AdjustAsciiFont(-1)" class="px-control px-1.5 text-[#eae6df] hover:text-[#e5a030] transition-colors duration-150 cursor-pointer">-</button>
                        <span class="w-9 text-center font-mono text-[11px] text-[#eae6df]">@(_asciiFontSizePx)px</span>
                        <button type="button" @onclick="() => AdjustAsciiFont(1)" class="px-control px-1.5 text-[#eae6df] hover:text-[#e5a030] transition-colors duration-150 cursor-pointer">+</button>
                    </div>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.ContentCopy"
                               Disabled="@(_asciiResult is null)"
                               OnClick="CopyAsciiPlainTextAsync">
                        Copy text
                    </MudButton>
                }
                else
                {
                    <MudSwitch T="bool"
                               Value="StudioState.ShowGrid"
                               ValueChanged="OnGridToggled"
                               Color="Color.Primary"
                               Label="Grid"
                               Size="Size.Small" />
                }

                <div class="flex h-8 items-center gap-1 rounded-[3px] border border-[#3d3d3d] bg-[#222222] px-2 text-xs">
                    <button type="button" @onclick="() => AdjustZoom(-15)" class="px-control px-1.5 text-[#eae6df] hover:text-[#e5a030] transition-colors duration-150 cursor-pointer">-</button>
                    <button type="button" @onclick="ResetZoom" class="px-control w-11 text-center font-mono text-[11px] text-[#eae6df] hover:text-[#e5a030] transition-colors duration-150 cursor-pointer">@(StudioState.ZoomPercent)%</button>
                    <button type="button" @onclick="() => AdjustZoom(15)" class="px-control px-1.5 text-[#eae6df] hover:text-[#e5a030] transition-colors duration-150 cursor-pointer">+</button>
                </div>
            </div>
        </div>

        @* Quick Paint Sub-Toolbar *@
        @if (_quickPaintEnabled)
        {
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#2e2e2e] bg-[#1b1b1b] px-4 py-2">
                @if (_mode == ProjectMode.Ascii)
                {
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                        <span class="font-medium text-[#e5a030]">Quick paint</span>
                        <label class="text-[#96928b]">Glyph</label>
                        <input type="text"
                               maxlength="1"
                               value="@_paintGlyph"
                               @oninput="OnPaintGlyphInput"
                               class="px-control h-8 w-8 rounded-[3px] border border-[#3d3d3d] bg-[#222222] text-center font-mono text-xs text-[#eae6df] focus:outline-none" />
                        <div class="flex items-center gap-1">
                            @foreach (var g in _quickAsciiGlyphs)
                            {
                                var selected = _paintGlyph == g;
                                <button type="button"
                                        @onclick="() => _paintGlyph = g"
                                        class="@(selected ? "border-[#e5a030] bg-[#e5a030]/15 text-[#e5a030]" : "border-[#3d3d3d] bg-[#222222] text-[#eae6df] hover:bg-[#2a2a2a]") px-control h-8 w-7 rounded-[3px] border font-mono text-xs transition-colors duration-150 cursor-pointer">
                                    @g
                                </button>
                            }
                        </div>
                        <label class="ml-2 text-[#96928b]">Color</label>
                        <input type="color"
                               value="@_paintHexColor"
                               @oninput="OnPaintColorInput"
                               class="px-control h-8 w-8 cursor-pointer rounded-[3px] border border-[#3d3d3d] bg-[#222222] p-0.5" />
                    </div>
                }
                else
                {
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                        <span class="font-medium text-[#e5a030]">Quick paint</span>
                        <div class="h-6 w-6 rounded-[2px] border border-[#3d3d3d]"
                             style="@($"background-color: {(_paintEraser ? "transparent" : _paintHexColor)};")"></div>
                        <span class="font-mono text-[11px] text-[#96928b]">@(_paintEraser ? "Eraser" : _paintHexColor)</span>
                        <button type="button"
                                @onclick="() => _paintEraser = !_paintEraser"
                                class="@(_paintEraser ? "border-[#e5a030] bg-[#e5a030]/15 text-[#e5a030]" : "border-[#3d3d3d] bg-[#222222] text-[#eae6df] hover:bg-[#2a2a2a]") px-btn border px-2.5 text-xs cursor-pointer">
                            Eraser
                        </button>
                        <input type="color"
                               value="@_paintHexColor"
                               @oninput="OnPaintColorInput"
                               class="px-control h-8 w-8 cursor-pointer rounded-[3px] border border-[#3d3d3d] bg-[#222222] p-0.5" />
                    </div>
                }

                <span class="text-xs text-[#96928b]">Click any cell to edit</span>
            </div>
        }

        @* Checkerboard Canvas Stage (1px crisp frame, no glows or drop shadows) *@
        <div class="pixcii-checkerboard flex flex-1 items-center justify-center overflow-auto p-6">
            @if (_mode == ProjectMode.Ascii && _asciiResult is not null)
            {
                var onionAscii = GetOnionSkinAscii();

                <div class="relative rounded-[3px] border border-[#3d3d3d] bg-[#141414] p-4"
                     style="@($"transform: scale({StudioState.ZoomPercent / 100.0:F2}); transform-origin: center center;")">
                    @if (onionAscii is not null)
                    {
                        <pre class="pointer-events-none absolute inset-4 m-0 font-mono leading-[1.15] whitespace-pre opacity-30 select-none"
                             style="@($"font-size: {_asciiFontSizePx}px;")">@((MarkupString)onionAscii.ColoredHtml)</pre>
                    }

                    @if (_quickPaintEnabled)
                    {
                        <pre class="relative z-10 m-0 font-mono leading-[1.15] select-none whitespace-pre"
                             style="@($"font-size: {_asciiFontSizePx}px;")">@for (var r = 0; r < _asciiResult.Rows; r++)
                        {
                            var row = r;
                            for (var c = 0; c < _asciiResult.Columns; c++)
                            {
                                var col = c;
                                var cell = _asciiResult.Grid[row, col];
                                <span @onclick="() => PaintAsciiCell(row, col)"
                                      class="cursor-crosshair hover:outline hover:outline-1 hover:outline-[#e5a030]"
                                      style="@($"color: {cell.HexColor};")">@cell.Glyph</span>
                            }
                            @("\n")
                        }</pre>
                    }
                    else
                    {
                        <pre class="relative z-10 m-0 font-mono leading-[1.15] select-text whitespace-pre"
                             style="@($"font-size: {_asciiFontSizePx}px;")">@((MarkupString)_asciiResult.ColoredHtml)</pre>
                    }
                </div>
            }
            else if (_mode == ProjectMode.PixelArt && _pixelResult is not null)
            {
                var baseWidthPx = Math.Clamp(_pixelResult.Width * 10, 280, 520);
                var scaledWidthPx = (int)Math.Round(baseWidthPx * (StudioState.ZoomPercent / 100.0));
                var scaledHeightPx = (int)Math.Round(scaledWidthPx * ((double)_pixelResult.Height / _pixelResult.Width));
                var onionPixelBase64 = GetOnionSkinPixelBase64();

                <div class="pixcii-checkerboard relative overflow-hidden rounded-[3px] border border-[#3d3d3d]"
                     style="@($"width: {scaledWidthPx}px; height: {scaledHeightPx}px;")">
                    @if (!string.IsNullOrEmpty(onionPixelBase64))
                    {
                        <img src="@($"data:image/png;base64,{onionPixelBase64}")"
                             alt="Onion skin previous frame"
                             class="pixelated pointer-events-none absolute inset-0 block h-full w-full opacity-30 select-none"
                             style="image-rendering: pixelated;" />
                    }

                    <img src="@_pixelResult.DataUrl"
                         alt="Converted pixel art"
                         class="pixelated relative z-10 block h-full w-full select-none"
                         style="image-rendering: pixelated;" />

                    @if (StudioState.ShowGrid)
                    {
                        <div class="pointer-events-none absolute inset-0 z-20 opacity-25"
                             style="@($"background-image: linear-gradient(to right, #96928b 1px, transparent 1px), linear-gradient(to bottom, #96928b 1px, transparent 1px); background-size: calc(100% / {_pixelResult.Width}) calc(100% / {_pixelResult.Height});")">
                        </div>
                    }

                    @if (_quickPaintEnabled)
                    {
                        <div class="absolute inset-0 z-30 grid"
                             style="@($"grid-template-columns: repeat({_pixelResult.Width}, minmax(0, 1fr)); grid-template-rows: repeat({_pixelResult.Height}, minmax(0, 1fr));")">
                            @for (var r = 0; r < _pixelResult.Height; r++)
                            {
                                var row = r;
                                @for (var c = 0; c < _pixelResult.Width; c++)
                                {
                                    var col = c;
                                    <button type="button"
                                            title="@($"({col}, {row})")"
                                            @onclick="() => PaintPixelCell(row, col)"
                                            class="h-full w-full border-0 bg-transparent p-0 cursor-crosshair hover:bg-white/15">
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="rounded-[3px] border border-dashed border-[#3d3d3d] bg-[#1b1b1b] p-8 text-center text-xs text-[#96928b]">
                    Drop an image here or click Upload
                </div>
            }
        </div>

        @* Bottom Timeline *@
        <AnimationTimeline Mode="_mode"
                           HasCanvasContent="HasActiveCanvas"
                           OnCaptureCurrentCanvas="CaptureCurrentCanvasAsFrame"
                           OnGenerateFx="GenerateInstantFxAsync" />
    </div>
</div>

@code {
    [Parameter] public Guid? ProjectId { get; set; }

    private const long MaxUploadSizeBytes = 5 * 1024 * 1024;

    private static readonly char[] _quickAsciiGlyphs = ['@', '#', '%', '*', '+', '=', '-', ':', '.', ' '];

    private Guid? _loadedProjectId;
    private string _projectTitle = "Untitled Sprite";
    private string _authorName = "Classmate";
    private bool _isPublic = true;
    private ProjectMode _mode = ProjectMode.Ascii;
    private byte[]? _sourceBytes;
    private string _sourceFileName = "sample-synthwave.png";

    private int _asciiWidth = 64;
    private int _pixelGridSize = 32;
    private float _brightness = 1.0f;
    private float _contrast = 1.0f;
    private bool _invertBrightness;

    private string _rampPreset = "Standard";
    private string _customRamp = AsciiRamps.Standard;
    private AsciiColorMode _asciiColorMode = AsciiColorMode.FullColorHtml;

    private IReadOnlyList<CustomPalette> _palettes = [];
    private Guid _selectedPaletteId;
    private bool _applyDithering;

    private bool _isConverting;
    private bool _quickPaintEnabled;
    private int _asciiFontSizePx = 11;
    private char _paintGlyph = '@';
    private string _paintHexColor = "#E5A030";
    private bool _paintEraser;

    private AsciiResult? _asciiResult;
    private PixelArtResult? _pixelResult;

    private CancellationTokenSource? _debounceCts;

    private bool HasActiveCanvas =>
        (_mode == ProjectMode.Ascii && _asciiResult is not null) ||
        (_mode == ProjectMode.PixelArt && _pixelResult is not null);

    private string[] ActivePaletteColors =>
        _palettes.FirstOrDefault(p => p.Id == _selectedPaletteId)?.HexColors ?? ["#0F380F", "#306230", "#8BAC0F", "#9BBC0F"];

    protected override async Task OnInitializedAsync()
    {
        StudioState.OnChange += HandleStudioStateChanged;
        StudioState.OnFrameSelected += HandleFrameSelected;
        StudioState.RegisterSaveHandler(OpenSaveDialogAsync);

        _palettes = await ProjectService.GetPalettesAsync();
        if (_palettes.Count > 0)
        {
            var pico8 = _palettes.FirstOrDefault(p => p.Name == "PICO-8") ?? _palettes[0];
            _selectedPaletteId = pico8.Id;
        }

        if (!ProjectId.HasValue)
        {
            StudioState.ResetForNewProject();
            await LoadSampleImageAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId.HasValue && ProjectId.Value != _loadedProjectId)
        {
            await LoadSavedProjectAsync(ProjectId.Value);
        }
        else if (!ProjectId.HasValue && _loadedProjectId.HasValue)
        {
            _loadedProjectId = null;
            _projectTitle = "Untitled Sprite";
            _isPublic = true;
            StudioState.ResetForNewProject();
            await LoadSampleImageAsync();
        }
    }

    private async Task LoadSampleImageAsync()
    {
        _sourceBytes = MediaConversionService.CreateSampleArtworkPng(128);
        _sourceFileName = "sample-synthwave.png";
        await RunConversionAsync(CancellationToken.None);
    }

    private async Task OnFileUploadedAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        if (file.Size > MaxUploadSizeBytes)
        {
            Snackbar.Add("Image exceeds the 5 MB limit.", Severity.Warning);
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxUploadSizeBytes);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            _sourceBytes = ms.ToArray();
            _sourceFileName = file.Name;
            await RunConversionAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load image: {ex.Message}", Severity.Error);
        }
    }

    private Task OnModeChanged(ProjectMode mode)
    {
        _mode = mode;
        StudioState.SetMode(mode == ProjectMode.Ascii ? CanvasMode.Ascii : CanvasMode.Pixel);
        return RunConversionAsync(CancellationToken.None);
    }

    private void OnAsciiWidthChanged(int value)
    {
        _asciiWidth = value;
        ScheduleDebouncedConversion();
    }

    private void OnPixelGridSizeChanged(int value)
    {
        _pixelGridSize = value;
        ScheduleDebouncedConversion();
    }

    private void OnBrightnessChanged(float value)
    {
        _brightness = value;
        ScheduleDebouncedConversion();
    }

    private void OnContrastChanged(float value)
    {
        _contrast = value;
        ScheduleDebouncedConversion();
    }

    private void OnInvertChanged(bool value)
    {
        _invertBrightness = value;
        ScheduleDebouncedConversion();
    }

    private void OnRampPresetChanged(string preset)
    {
        _rampPreset = preset;
        if (preset != "Custom")
        {
            _customRamp = ResolveRamp(preset);
        }
        ScheduleDebouncedConversion();
    }

    private void OnCustomRampChanged(string value)
    {
        _customRamp = string.IsNullOrEmpty(value) ? AsciiRamps.Standard : value;
        ScheduleDebouncedConversion();
    }

    private void OnAsciiColorModeChanged(AsciiColorMode colorMode)
    {
        _asciiColorMode = colorMode;
        ScheduleDebouncedConversion();
    }

    private void OnPaletteChanged(Guid paletteId)
    {
        _selectedPaletteId = paletteId;
        var colors = ActivePaletteColors;
        if (colors.Length > 0)
        {
            _paintHexColor = colors[0];
        }
        ScheduleDebouncedConversion();
    }

    private void OnDitheringChanged(bool enabled)
    {
        _applyDithering = enabled;
        ScheduleDebouncedConversion();
    }

    private void ScheduleDebouncedConversion()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        _ = DebounceAndConvertAsync(token);
    }

    private async Task DebounceAndConvertAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(120, token);
            await InvokeAsync(() => RunConversionAsync(token));
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RunConversionAsync(CancellationToken token)
    {
        if (_sourceBytes is null || _sourceBytes.Length == 0)
        {
            return;
        }

        _isConverting = true;
        StateHasChanged();

        try
        {
            var bytes = _sourceBytes;
            if (_mode == ProjectMode.Ascii)
            {
                var ramp = _rampPreset == "Custom" ? _customRamp : ResolveRamp(_rampPreset);
                var result = await Task.Run(
                    () => ConversionService.ConvertToAsciiAsync(
                        bytes,
                        targetWidth: _asciiWidth,
                        characterRamp: ramp,
                        invertBrightness: _invertBrightness,
                        colorMode: _asciiColorMode,
                        brightness: _brightness,
                        contrast: _contrast,
                        ct: token),
                    token);

                if (!token.IsCancellationRequested)
                {
                    _asciiResult = result;
                    StudioState.SetActiveCanvas(_mode, _asciiResult, _pixelResult);
                }
            }
            else
            {
                var palette = ActivePaletteColors;
                var result = await Task.Run(
                    () => ConversionService.ConvertToPixelArtAsync(
                        bytes,
                        gridSize: _pixelGridSize,
                        hexPalette: palette,
                        applyDithering: _applyDithering,
                        brightness: _brightness,
                        contrast: _contrast,
                        invertBrightness: _invertBrightness,
                        ct: token),
                    token);

                if (!token.IsCancellationRequested)
                {
                    _pixelResult = result;
                    StudioState.SetActiveCanvas(_mode, _asciiResult, _pixelResult);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Conversion error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isConverting = false;
            StateHasChanged();
        }
    }

    private void PaintAsciiCell(int row, int col)
    {
        if (_asciiResult is null)
        {
            return;
        }

        _asciiResult.Grid[row, col] = new AsciiCell(_paintGlyph, _paintHexColor);
        var (plainText, coloredHtml) = MediaConversionService.BuildAsciiTextAndHtml(_asciiResult.Grid, _asciiColorMode);
        _asciiResult = _asciiResult with { PlainText = plainText, ColoredHtml = coloredHtml };
        StudioState.SetActiveCanvas(_mode, _asciiResult, _pixelResult);

        if (StudioState.ActiveFrame is not null)
        {
            StudioState.UpdateActiveFrameContent(FrameSerialization.SerializeAscii(_asciiResult), null);
        }
    }

    private void PaintPixelCell(int row, int col)
    {
        if (_pixelResult is null)
        {
            return;
        }

        _pixelResult.HexGrid[row, col] = _paintEraser ? string.Empty : _paintHexColor;
        _pixelResult = MediaConversionService.RenderHexGridToPixelArt(_pixelResult.HexGrid);
        StudioState.SetActiveCanvas(_mode, _asciiResult, _pixelResult);

        if (StudioState.ActiveFrame is not null)
        {
            StudioState.UpdateActiveFrameContent(
                FrameSerialization.SerializePixelGrid(_pixelResult),
                _pixelResult.Base64Png);
        }
    }

    private async Task LoadSavedProjectAsync(Guid projectId)
    {
        var project = await ProjectService.GetProjectWithFramesAsync(projectId);
        if (project is null)
        {
            Snackbar.Add("Project not found.", Severity.Warning);
            await LoadSampleImageAsync();
            return;
        }

        _loadedProjectId = project.Id;
        _projectTitle = project.Title;
        _authorName = project.AuthorName;
        _isPublic = project.IsPublic;
        _mode = project.Mode;
        _customRamp = project.CharacterRamp;
        _sourceFileName = project.Title;

        var matchedPalette = _palettes.FirstOrDefault(p =>
            string.Equals(p.Name, project.PaletteName, StringComparison.OrdinalIgnoreCase));
        if (matchedPalette is not null)
        {
            _selectedPaletteId = matchedPalette.Id;
        }

        StudioState.SetFps(Math.Clamp(project.Fps, 1, 24));
        StudioState.SetProjectMetadata(
            project.Title,
            project.Width,
            project.Height,
            StudioState.Fps,
            project.Mode == ProjectMode.Ascii ? CanvasMode.Ascii : CanvasMode.Pixel);

        var loadedFrames = project.ArtFrames
            .OrderBy(f => f.OrderIndex)
            .Select(f => new ArtFrame
            {
                Id = f.Id,
                StudioProjectId = project.Id,
                OrderIndex = f.OrderIndex,
                AsciiContent = f.AsciiContent,
                PixelDataBase64 = f.PixelDataBase64,
                DurationMs = f.DurationMs
            })
            .ToList();

        StudioState.ReplaceFrames(loadedFrames);
        if (loadedFrames.Count > 0)
        {
            ApplyFrameToCanvas(loadedFrames[0]);
        }

        Snackbar.Add(
            project.RemixedFromId.HasValue
                ? $"Loaded remix \"{project.Title}\"."
                : $"Loaded \"{project.Title}\".",
            Severity.Info);
    }

    private async Task OpenSaveDialogAsync()
    {
        if (!HasActiveCanvas && StudioState.Frames.Count == 0)
        {
            Snackbar.Add("Drop or upload an image before saving.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<SaveProjectDialog>
        {
            { x => x.InitialTitle, _projectTitle },
            { x => x.InitialAuthorName, _authorName },
            { x => x.InitialIsPublic, _isPublic }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<SaveProjectDialog>("Save project", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not SaveProjectDialog.SaveProjectResult saveReq)
        {
            return;
        }

        try
        {
            var framesToSave = BuildFramesForSave();
            var (width, height) = GetCurrentDimensions();
            var paletteName = _palettes.FirstOrDefault(p => p.Id == _selectedPaletteId)?.Name ?? "PICO-8";
            var ramp = _rampPreset == "Custom" ? _customRamp : ResolveRamp(_rampPreset);

            StudioProject saved;
            if (_loadedProjectId.HasValue)
            {
                saved = await ProjectService.UpdateProjectMetadataAsync(
                    _loadedProjectId.Value,
                    saveReq.Title,
                    saveReq.AuthorName,
                    _mode,
                    width,
                    height,
                    StudioState.Fps,
                    paletteName,
                    ramp,
                    saveReq.IsPublic);
                await ProjectService.SaveFramesAsync(saved.Id, framesToSave);
            }
            else
            {
                saved = await ProjectService.CreateProjectAsync(
                    saveReq.Title,
                    saveReq.AuthorName,
                    _mode,
                    width,
                    height,
                    StudioState.Fps,
                    paletteName,
                    ramp,
                    saveReq.IsPublic,
                    initialFrames: framesToSave);
            }

            _loadedProjectId = saved.Id;
            _projectTitle = saved.Title;
            _authorName = saved.AuthorName;
            _isPublic = saved.IsPublic;
            _sourceFileName = saved.Title;

            StudioState.SetProjectMetadata(
                saved.Title,
                width,
                height,
                StudioState.Fps,
                _mode == ProjectMode.Ascii ? CanvasMode.Ascii : CanvasMode.Pixel);

            Snackbar.Add(
                saved.IsPublic
                    ? $"Saved \"{saved.Title}\" to the Gallery."
                    : $"Saved \"{saved.Title}\".",
                Severity.Success);

            if (ProjectId != saved.Id)
            {
                Navigation.NavigateTo($"/studio/{saved.Id}", replace: true);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save project: {ex.Message}", Severity.Error);
        }
    }

    private List<ArtFrame> BuildFramesForSave()
    {
        if (StudioState.Frames.Count > 0)
        {
            return StudioState.Frames.ToList();
        }

        var durationMs = Math.Max(40, 1000 / StudioState.Fps);
        if (_mode == ProjectMode.Ascii && _asciiResult is not null)
        {
            return [FrameSerialization.ToArtFrame(_asciiResult, 0, durationMs)];
        }
        if (_mode == ProjectMode.PixelArt && _pixelResult is not null)
        {
            return [FrameSerialization.ToArtFrame(_pixelResult, 0, durationMs)];
        }
        return [];
    }

    private (int Width, int Height) GetCurrentDimensions()
    {
        if (_mode == ProjectMode.Ascii && _asciiResult is not null)
        {
            return (_asciiResult.Columns, _asciiResult.Rows);
        }
        if (_mode == ProjectMode.PixelArt && _pixelResult is not null)
        {
            return (_pixelResult.Width, _pixelResult.Height);
        }
        return (32, 32);
    }

    private void ApplyFrameToCanvas(ArtFrame frame)
    {
        if (_mode == ProjectMode.Ascii)
        {
            var parsed = FrameSerialization.DeserializeAscii(
                frame.AsciiContent,
                MediaConversionService.BuildAsciiTextAndHtml,
                _asciiColorMode);
            if (parsed is not null)
            {
                _asciiResult = parsed;
            }
        }
        else
        {
            var grid = FrameSerialization.DeserializePixelGrid(frame.AsciiContent);
            if (grid is not null)
            {
                _pixelResult = MediaConversionService.RenderHexGridToPixelArt(grid);
            }
        }

        StudioState.SetActiveCanvas(_mode, _asciiResult, _pixelResult);
    }

    private void CaptureCurrentCanvasAsFrame()
    {
        var durationMs = Math.Max(40, 1000 / StudioState.Fps);

        if (_mode == ProjectMode.Ascii && _asciiResult is not null)
        {
            var frame = FrameSerialization.ToArtFrame(_asciiResult, StudioState.Frames.Count, durationMs);
            StudioState.AddFrame(frame);
            Snackbar.Add($"Added frame #{StudioState.Frames.Count}.", Severity.Success);
        }
        else if (_mode == ProjectMode.PixelArt && _pixelResult is not null)
        {
            var frame = FrameSerialization.ToArtFrame(_pixelResult, StudioState.Frames.Count, durationMs);
            StudioState.AddFrame(frame);
            Snackbar.Add($"Added frame #{StudioState.Frames.Count}.", Severity.Success);
        }
    }

    private Task GenerateInstantFxAsync(AnimationFxPreset preset)
    {
        if (_mode == ProjectMode.Ascii && _asciiResult is not null)
        {
            var generated = FxService.GenerateAsciiLoop(_asciiResult, preset, _asciiColorMode, StudioState.Fps);
            StudioState.ReplaceFrames(generated);
            Snackbar.Add($"Generated {generated.Count} frames.", Severity.Success);
        }
        else if (_mode == ProjectMode.PixelArt && _pixelResult is not null)
        {
            var generated = FxService.GeneratePixelArtLoop(_pixelResult, preset, ActivePaletteColors, StudioState.Fps);
            StudioState.ReplaceFrames(generated);
            Snackbar.Add($"Generated {generated.Count} frames.", Severity.Success);
        }

        return Task.CompletedTask;
    }

    private void HandleFrameSelected(int index)
    {
        if (index < 0 || index >= StudioState.Frames.Count)
        {
            return;
        }

        var frame = StudioState.Frames[index];
        _ = InvokeAsync(() =>
        {
            ApplyFrameToCanvas(frame);
            StateHasChanged();
        });
    }

    private AsciiResult? GetOnionSkinAscii()
    {
        if (!StudioState.OnionSkinningEnabled || StudioState.IsPlaying || StudioState.PreviousFrame is not { } prev)
        {
            return null;
        }

        return FrameSerialization.DeserializeAscii(
            prev.AsciiContent,
            MediaConversionService.BuildAsciiTextAndHtml,
            _asciiColorMode);
    }

    private string? GetOnionSkinPixelBase64()
    {
        if (!StudioState.OnionSkinningEnabled || StudioState.IsPlaying || StudioState.PreviousFrame is not { } prev)
        {
            return null;
        }

        return prev.PixelDataBase64;
    }

    private void SelectPaintColor(string hex)
    {
        _paintEraser = false;
        _paintHexColor = hex;
        StudioState.SetPrimaryColor(hex);
    }

    private void OnPaintGlyphInput(ChangeEventArgs e)
    {
        var str = e.Value?.ToString();
        if (!string.IsNullOrEmpty(str))
        {
            _paintGlyph = str[0];
            StudioState.SetActiveGlyph(_paintGlyph);
        }
    }

    private void OnPaintColorInput(ChangeEventArgs e)
    {
        var hex = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(hex))
        {
            SelectPaintColor(hex.ToUpperInvariant());
        }
    }

    private void OnGridToggled(bool value) => StudioState.SetShowGrid(value);

    private void AdjustAsciiFont(int delta)
        => _asciiFontSizePx = Math.Clamp(_asciiFontSizePx + delta, 6, 28);

    private void AdjustZoom(int delta)
        => StudioState.SetZoom(StudioState.ZoomPercent + delta);

    private void ResetZoom() => StudioState.SetZoom(100);

    private void HandleStudioStateChanged() => InvokeAsync(StateHasChanged);

    private async Task CopyAsciiPlainTextAsync()
    {
        if (_asciiResult is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _asciiResult.PlainText);
            Snackbar.Add("Copied text to clipboard.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Clipboard copy failed in this browser context.", Severity.Warning);
        }
    }

    private static string ResolveRamp(string preset) => preset switch
    {
        "Dense" => AsciiRamps.Dense,
        "Blocks" => AsciiRamps.Blocks,
        "Minimal" => AsciiRamps.Minimal,
        _ => AsciiRamps.Standard
    };

    public void Dispose()
    {
        StudioState.OnChange -= HandleStudioStateChanged;
        StudioState.OnFrameSelected -= HandleFrameSelected;
        StudioState.RegisterSaveHandler(null);
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
