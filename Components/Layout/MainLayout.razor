@inherits LayoutComponentBase
@implements IDisposable
@inject StudioStateService StudioState
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudThemeProvider IsDarkMode="true" Theme="StudioTheme.RetroDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="h-screen w-screen overflow-hidden bg-[#141414]">
    @* Top Toolbar *@
    <MudAppBar Elevation="0" Dense="true" Class="border-b border-[#2e2e2e] bg-[#1b1b1b] px-3">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       Size="Size.Small"
                       OnClick="ToggleDrawer"
                       aria-label="Toggle tool panel" />

        <div class="ml-2 flex items-center gap-2">
            <div class="flex h-7 w-7 items-center justify-center rounded-[3px] border border-[#3d3d3d] bg-[#222222] font-mono text-xs font-semibold text-[#e5a030]">
                P#
            </div>
            <span class="text-sm font-semibold text-[#eae6df]">Pixcii</span>
        </div>

        @if (!IsGalleryRoute)
        {
            <div class="ml-5 hidden items-center gap-2 rounded-[3px] border border-[#2e2e2e] bg-[#222222] px-2.5 py-1 md:flex">
                <span class="max-w-[180px] truncate text-xs text-[#eae6df]">@StudioState.Metadata.ProjectName</span>
                <span class="text-[#5a5752]">|</span>
                <span class="font-mono text-[11px] text-[#96928b]">@StudioState.Metadata.Width&times;@StudioState.Metadata.Height</span>
                <span class="text-[#5a5752]">|</span>
                <span class="font-mono text-[11px] text-[#96928b]">@StudioState.Metadata.Fps FPS</span>
            </div>
        }

        <MudSpacer />

        @* Navigation *@
        <div class="mr-3 flex items-center gap-1">
            <MudButton Variant="Variant.Text"
                       Color="Color.Inherit"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Brush"
                       Href="/studio">
                Studio
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Inherit"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.GridView"
                       Href="/gallery">
                Gallery
            </MudButton>
        </div>

        @* Primary & Secondary Actions *@
        @if (!IsGalleryRoute)
        {
            <div class="flex items-center gap-2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Save"
                           OnClick="HandleSaveAsync">
                    Save
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.IosShare"
                           OnClick="HandleExportAsync">
                    Export
                </MudButton>
            </div>
        }
    </MudAppBar>

    @* Secondary Tool Drawer *@
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Persistent"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Class="border-r border-[#2e2e2e] bg-[#1b1b1b]">
        <div class="flex h-full flex-col justify-between p-4 select-none">
            <div class="flex flex-col gap-5">
                <div>
                    <div class="mb-2 text-sm font-semibold text-[#eae6df]">Tools</div>
                    <div class="grid grid-cols-2 gap-1.5">
                        @foreach (var tool in _tools)
                        {
                            var isSelected = StudioState.ActiveTool == tool.Tool;
                            <MudButton Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                       Color="@(isSelected ? Color.Primary : Color.Default)"
                                       Size="Size.Small"
                                       StartIcon="@tool.Icon"
                                       Class="justify-start text-xs"
                                       OnClick="() => StudioState.SelectTool(tool.Tool)">
                                @tool.Label
                            </MudButton>
                        }
                    </div>
                </div>

                <hr class="m-0 border-0 border-t border-[#2e2e2e]" />

                <div class="flex flex-col gap-2">
                    <div class="text-sm font-semibold text-[#eae6df]">Ink &amp; glyph</div>
                    <div class="flex items-center gap-2 rounded-[3px] border border-[#2e2e2e] bg-[#222222] p-2">
                        <div class="h-7 w-7 shrink-0 rounded-[2px] border border-[#3d3d3d]"
                             style="@($"background-color: {StudioState.PrimaryColor};")">
                        </div>
                        <div class="flex flex-col leading-tight">
                            <span class="font-mono text-[11px] text-[#eae6df]">@StudioState.PrimaryColor</span>
                            <span class="font-mono text-[11px] text-[#96928b]">Glyph '@StudioState.ActiveAsciiGlyph'</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-6 gap-1">
                        @foreach (var ch in _quickGlyphs)
                        {
                            var selected = StudioState.ActiveAsciiGlyph == ch;
                            <button type="button"
                                    @onclick="() => StudioState.SetActiveGlyph(ch)"
                                    class="@(selected ? "border-[#e5a030] bg-[#e5a030]/15 text-[#e5a030]" : "border-[#2e2e2e] bg-[#222222] text-[#eae6df] hover:bg-[#2a2a2a]") px-control flex h-8 items-center justify-center rounded-[3px] border font-mono text-xs transition-colors duration-150 cursor-pointer">
                                @ch
                            </button>
                        }
                    </div>
                </div>

                <hr class="m-0 border-0 border-t border-[#2e2e2e]" />

                <div class="flex flex-col gap-2">
                    <div class="text-sm font-semibold text-[#eae6df]">View</div>
                    <MudSwitch T="bool"
                               Value="StudioState.ShowGrid"
                               ValueChanged="@(_ => StudioState.ToggleGrid())"
                               Color="Color.Primary"
                               Label="Pixel grid"
                               Size="Size.Small" />
                </div>
            </div>

            <div class="rounded-[3px] border border-[#2e2e2e] bg-[#222222] px-3 py-2 text-xs text-[#96928b]">
                <div>Tool: <span class="text-[#eae6df]">@StudioState.ActiveTool</span></div>
                <div>Mode: <span class="text-[#eae6df]">@StudioState.Metadata.Mode</span></div>
            </div>
        </div>
    </MudDrawer>

    @* Workspace Area *@
    <MudMainContent Class="flex h-screen min-w-0 flex-col overflow-hidden">
        <div class="pixcii-workspace flex min-w-0 flex-1 overflow-hidden">
            @Body
        </div>

        @if (!IsGalleryRoute)
        {
            var sizeUnit = StudioState.CurrentProjectMode == ProjectMode.Ascii ? "chars" : "px";
            <footer class="flex h-7 shrink-0 items-center justify-between border-t border-[#2e2e2e] bg-[#1b1b1b] px-4 text-[11px] text-[#96928b]">
                <div class="flex items-center gap-4">
                    <span>Canvas <span class="font-mono text-[#eae6df]">@StudioState.Metadata.Width&times;@StudioState.Metadata.Height @sizeUnit</span></span>
                    <span>Grid <span class="font-mono text-[#eae6df]">@(StudioState.ShowGrid ? "On" : "Off")</span></span>
                </div>
                <div class="flex items-center gap-4">
                    <span>Zoom <span class="font-mono text-[#eae6df]">@StudioState.ZoomPercent%</span></span>
                    <span>Ready</span>
                </div>
            </footer>
        }
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#10005;</span>
</div>

@code {
    private bool _drawerOpen = false;

    private static readonly char[] _quickGlyphs = ['@', '#', '%', '*', '+', ':', '.', '/', '\\', '|', '-', '~'];

    private static readonly (StudioTool Tool, string Label, string Icon)[] _tools =
    [
        (StudioTool.Pencil, "Pencil", Icons.Material.Outlined.Edit),
        (StudioTool.Eraser, "Eraser", Icons.Material.Outlined.AutoFixOff),
        (StudioTool.AsciiBrush, "ASCII", Icons.Material.Outlined.TextFields),
        (StudioTool.FillBucket, "Fill", Icons.Material.Outlined.FormatColorFill),
        (StudioTool.Eyedropper, "Picker", Icons.Material.Outlined.Colorize),
        (StudioTool.Marquee, "Select", Icons.Material.Outlined.SelectAll)
    ];

    private bool IsGalleryRoute =>
        Navigation.ToBaseRelativePath(Navigation.Uri)
            .StartsWith("gallery", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        StudioState.OnChange += HandleStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task HandleSaveAsync()
    {
        await StudioState.RequestSaveAsync();
    }

    private async Task HandleExportAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        await DialogService.ShowAsync<ExportDialog>("Export", options);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        StudioState.OnChange -= HandleStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
